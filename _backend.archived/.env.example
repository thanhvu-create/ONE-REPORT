# Backend-local .env (for running outside Docker)
DATABASE_URL=postgresql://onereport:onereport@localhost:5432/onereport?schema=public
JWT_SECRET=change-me-please-use-at-least-32-random-bytes-here
JWT_EXPIRES_IN=24h
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TRANSCRIPTION_MODEL=whisper-1
UPLOAD_DIR=./uploads/audio
MAX_UPLOAD_MB=25
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
PORT=4000
NODE_ENV=development
LOG_LEVEL=debug

# Object storage (default: local disk at UPLOAD_DIR)
STORAGE_DRIVER=local

# Only required when STORAGE_DRIVER=s3
S3_REGION=us-east-1
S3_BUCKET=one-report
S3_PREFIX=audio
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
