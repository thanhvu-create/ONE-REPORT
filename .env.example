# ===== Database (Supabase) =====
# Connection pooling URL (PgBouncer, port 6543) — used at runtime
DATABASE_URL=postgresql://user:password@host:6543/postgres

# Direct connection URL (port 5432) — used by Prisma migrate / db push
DIRECT_URL=postgresql://user:password@host:5432/postgres

# ===== Auth =====
JWT_SECRET=change-me-to-a-random-base64-string
JWT_EXPIRES_IN=24h

# ===== AI (Google Gemini) =====
# Get API key at https://aistudio.google.com/apikey
# Leave empty to use mock mode (no real AI, returns placeholder data)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ===== Reminders (SMTP — optional) =====
# If SMTP_HOST is set, a daily email is sent listing employees who haven't submitted a report.
# Leave all blank to disable email (cron still runs and logs to function logs).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_NOTIFY_TO=

# ===== Cron (Vercel) =====
# Set to a random secret; Vercel passes it as Bearer token when invoking /api/cron/reminders
CRON_SECRET=
